# ---------------------------------------------------------------------------
# Llama Pilot SPA - Vite environment variables
# Copy to `.env` (or `.env.local`) and fill in the values for your environment.
# All variables MUST be prefixed with VITE_ to be exposed to the client bundle.
# NOTE: none of these are secrets. PKCE is used (no client secret in the SPA).
# ---------------------------------------------------------------------------

# AWS region hosting the Cognito user pool (e.g. us-east-1)
VITE_AWS_REGION=us-east-1

# Cognito User Pool ID (e.g. us-east-1_abc123XYZ)
VITE_COGNITO_USER_POOL_ID=us-east-1_example

# Cognito App Client ID (public SPA client, no secret)
VITE_COGNITO_APP_CLIENT_ID=example-app-client-id

# Full Cognito Hosted UI domain, including https:// and no trailing slash
# e.g. https://llama-pilot-dev-xxxx.auth.us-east-1.amazoncognito.com
VITE_COGNITO_DOMAIN=https://llama-pilot-dev-xxxx.auth.us-east-1.amazoncognito.com

# OAuth2 redirect URI after successful sign-in (must be registered in Cognito)
VITE_COGNITO_REDIRECT_SIGN_IN=http://localhost:5173/

# Redirect URI after sign-out (must be registered in Cognito)
VITE_COGNITO_REDIRECT_SIGN_OUT=http://localhost:5173/

# Base URL of the FastAPI backend fronted by API Gateway (no trailing slash)
# e.g. https://abc123.execute-api.us-east-1.amazonaws.com
VITE_API_BASE_URL=https://api.example.execute-api.us-east-1.amazonaws.com

# Display name of the served model (badge in the UI)
VITE_MODEL_NAME=llama-pilot
