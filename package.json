{
  "name": "llama-eks-pilot",
  "version": "0.1.0",
  "description": "Self-hosted Llama pilot on Amazon EKS (AWS CDK v2, TypeScript)",
  "private": true,
  "bin": {
    "llama-eks-pilot": "bin/app.js"
  },
  "scripts": {
